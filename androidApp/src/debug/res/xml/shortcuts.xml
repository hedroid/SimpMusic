<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts. targetPackage must be present alongside targetClass or
     ShortcutParser drops the component and launchers cannot start the intent; debug builds
     carry the ".dev" applicationId, so the debug source set overrides this file with its
     own package name. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="home"
        android:enabled="true"
        android:icon="@drawable/round_home_24"
        android:shortcutShortLabel="@string/home">
        <intent
            android:action="com.maxrave.simpmusic.action.HOME"
            android:targetPackage="com.maxrave.simpmusic.dev"
            android:targetClass="com.maxrave.simpmusic.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/round_search_24"
        android:shortcutShortLabel="@string/search">
        <intent
            android:action="com.maxrave.simpmusic.action.SEARCH"
            android:targetPackage="com.maxrave.simpmusic.dev"
            android:targetClass="com.maxrave.simpmusic.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="library"
        android:enabled="true"
        android:icon="@drawable/round_library_music_24"
        android:shortcutShortLabel="@string/library">
        <intent
            android:action="com.maxrave.simpmusic.action.LIBRARY"
            android:targetPackage="com.maxrave.simpmusic.dev"
            android:targetClass="com.maxrave.simpmusic.MainActivity" />
    </shortcut>
</shortcuts>
